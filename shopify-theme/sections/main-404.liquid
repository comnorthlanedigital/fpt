<section class="not-found">
  <div class="wrap">
    <p class="not-found__code">404</p>
    <h1 class="display">{{ 'errors.404_title' | t }}</h1>
    <p class="muted">{{ 'errors.404_text' | t }}</p>
    <a class="btn btn--gold" href="{{ routes.all_products_collection_url }}">{{ 'errors.404_cta' | t }} {% render 'icon', name: 'arrow' %}</a>
  </div>
</section>

{% schema %}
{ "name": "404 page" }
{% endschema %}
