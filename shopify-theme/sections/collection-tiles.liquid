<section class="tiles-sec">
  <div class="wrap">
    <h2 class="display">{{ section.settings.heading }}</h2>
    <div class="tiles">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          {%- assign n = n | plus: 1 -%}
          {%- assign i0 = n | minus: 1 -%}
          {%- assign row = i0 | divided_by: 4 -%}
          {%- assign palette = i0 | plus: row | modulo: 4 -%}
          <a class="tile tile--{{ palette }}" href="{{ c.url }}" data-reveal {{ block.shopify_attributes }}>
            <span class="tile__n">{{ n | prepend: '00' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title | default: c.title }}</h3>
            <span class="tile__c">{{ 'collection.products_count' | t: count: c.all_products_count }} {% render 'icon', name: 'arrow' %}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "PICK YOUR LEAGUE" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [ { "name": "Collection tiles" } ]
}
{% endschema %}
