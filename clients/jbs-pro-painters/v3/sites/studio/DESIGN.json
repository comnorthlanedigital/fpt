  "narrative": {
    "northStar": "The Turntable Showroom",
    "overview": "A dark showroom with one lit object: a 3D stucco house on a turntable. The page is deliberately near-black so that every color that appears is a paint color the visitor chose. The hero background is a 34% mix of the current wall color into night ink, so picking walls repaints the room around the house.",
    "keyCharacteristics": [
      "Near-black ground; color comes only from the stage, the swatches and the photos.",
      "Page tint follows the chosen wall color (hero background, 0.9s transition).",
      "Pill geometry for every action; large soft radii for panels and media.",
      "One blue action color, used for the primary button and form submit.",
      "Wide extended display type (width axis 112-122%) over a neutral humanist body."
    ],
    "rules": [
      {
        "name": "The Chosen Color Rule",
        "body": "Outside the swatch palette and the single blue action, no saturated color appears in the interface. The page's only changing hue is the wall color the visitor picked.",
        "section": "colors"
      },
      {
        "name": "The Honest Swatch Rule",
        "body": "A swatch is added only when it matches a color from a real job or a plain neutral, and it is named by its look, never by a paint brand.",
        "section": "colors"
      },
      {
        "name": "The Wide Heading Rule",
        "body": "Headings use Anybody with the width axis raised (112-122%) and weight 800; never a narrow or default-width cut, and never Impact except as the failure fallback.",
        "section": "typography"
      },
      {
        "name": "The Lit Object Rule",
        "body": "Only the 3D house is allowed real lighting and shadow; all interface surfaces stay flat, separated by translucency and hairline borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the ground near-black (#12141a, #0b0c10) and let swatches, photos and the house carry color.",
      "Do make every action a pill with at least 40px height (56px for the primary).",
      "Do name colors by their look (\"Garage-door green\") and tie them to a real job photo where one exists.",
      "Do keep the 3D illustration disclaimer (\"3D illustration only\") under the hero.",
      "Do keep one Royal Blue primary action per view."
    ],
    "donts": [
      "Don't use a second saturated UI accent next to Royal Blue.",
      "Don't put shadows on interface surfaces; the stage lift is the only one.",
      "Don't set headings in a narrow or default-width face, or in the Impact fallback by choice.",
      "Don't name paint brands or show third-party brands in photos without owner approval (PRODUCT.md)."
    ]
  }
