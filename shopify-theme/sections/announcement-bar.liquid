{%- if section.settings.text != blank -%}
  <div class="announce">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      <span>{{ section.settings.text }}</span>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Buy 1, get 1 25% off. Use code FPTSPORTZ" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Announcement bar" } ]
}
{% endschema %}
