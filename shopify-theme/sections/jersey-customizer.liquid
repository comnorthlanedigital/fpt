<section class="cz" data-jersey-customizer>
  <div class="wrap cz__in">
    <div class="cz__stage" data-reveal>
      {% render 'jersey-svg', uid: section.id, name: section.settings.default_name, number: section.settings.default_number %}
    </div>
    <div class="cz__panel" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
      <label class="field">
        <span>{{ 'product.name_label' | t }}</span>
        <input type="text" maxlength="12" value="{{ section.settings.default_name }}" data-jersey-name autocomplete="off">
      </label>
      <label class="field">
        <span>{{ 'product.number_label' | t }}</span>
        <input type="text" inputmode="numeric" maxlength="2" value="{{ section.settings.default_number }}" data-jersey-number autocomplete="off">
      </label>
      <div class="swatches" role="group" aria-label="Kit style" data-jersey-themes></div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Jersey customizer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOUR NAME. YOUR NUMBER." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "See it before you buy it. On every jersey page you can add a name and number and watch the preview update." },
    { "type": "text", "id": "default_name", "label": "Starting name", "default": "LEGEND" },
    { "type": "text", "id": "default_number", "label": "Starting number", "default": "10" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your kit" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Jersey customizer" } ]
}
{% endschema %}
