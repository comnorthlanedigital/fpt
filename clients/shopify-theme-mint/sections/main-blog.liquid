<section class="sec"><div class="wrap wrap--narrow"><h1 class="sec__title left">{{ blog.title }}</h1>
{%- paginate blog.articles by 8 -%}{%- for article in blog.articles -%}<article class="line"><div><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p class="muted">{{ article.published_at | date: '%B %-d, %Y' }}</p><p>{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p></div></article>{%- endfor -%}
{%- if paginate.pages > 1 -%}<nav class="pager">{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}</nav>{%- endif -%}{%- endpaginate -%}</div></section>
{% schema %}
{"name":"Blog"}
{% endschema %}