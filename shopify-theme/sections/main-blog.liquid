{%- paginate blog.articles by 12 -%}
<section class="page">
  <div class="wrap">
    <h1 class="display">{{ blog.title }}</h1>
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="pcard pcard--text" data-reveal>
          <a href="{{ article.url }}">
            {%- if article.image -%}
              <div class="pcard__media">{{ article.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: article.title, widths: '320, 640', sizes: '(min-width: 1000px) 30vw, 90vw', class: 'pcard__img' }}</div>
            {%- endif -%}
            <h2 class="pcard__title">{{ article.title }}</h2>
            <p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </a>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
