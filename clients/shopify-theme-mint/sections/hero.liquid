<section class="hero{% if section.settings.image == blank %} hero--plain{% endif %}">
  {%- if section.settings.image != blank -%}<div class="hero__bg">{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2000', sizes: '100vw', alt: section.settings.image.alt }}</div>{%- endif -%}
  <div class="wrap hero__in">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<p class="hero__text">{{ section.settings.text }}</p>{% endif %}
    <div class="hero__cta">
      {% if section.settings.btn1_label != blank %}<a class="btn" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{% endif %}
      {% if section.settings.btn2_label != blank %}<a class="btn btn--ghost" href="{{ section.settings.btn2_link | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label }}</a>{% endif %}
    </div>
    {% if section.settings.note != blank %}<p class="hero__note">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Hero","settings":[
{"type":"image_picker","id":"image","label":"Background image"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Your tagline here"},
{"type":"text","id":"heading","label":"Heading","default":"A headline about your product."},
{"type":"textarea","id":"text","label":"Text","default":"One or two sentences about what you sell."},
{"type":"text","id":"btn1_label","label":"Primary button","default":"Shop now"},{"type":"url","id":"btn1_link","label":"Primary link"},
{"type":"text","id":"btn2_label","label":"Secondary button","default":"Learn more"},{"type":"url","id":"btn2_link","label":"Secondary link"},
{"type":"text","id":"note","label":"Small note under buttons","info":"Only use facts you can back up, like a real review count."}
],"presets":[{"name":"Hero"}]}
{% endschema %}