<section class="sec">
  <div class="wrap">
    <h2 class="sec__title">{{ section.settings.heading }}</h2>
    {% if section.settings.sub != blank %}<p class="center muted">{{ section.settings.sub }}</p>{% endif %}
    <div class="ben">
      {%- for block in section.blocks -%}
      <div class="ben__i" {{ block.shopify_attributes }}><span class="ben__ic">{% render 'icon', name: block.settings.icon %}</span><div><h3>{{ block.settings.title }}</h3><p class="muted">{{ block.settings.text }}</p></div></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why shop with us"},{"type":"text","id":"sub","label":"Subheading"}],
"blocks":[{"type":"benefit","name":"Benefit","settings":[
{"type":"select","id":"icon","label":"Icon","options":[{"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"headset","label":"Headset"},{"value":"star","label":"Star"}],"default":"truck"},
{"type":"text","id":"title","label":"Title","default":"Your benefit"},{"type":"textarea","id":"text","label":"Text","default":"Describe it with a fact you can keep, such as a real shipping time or return window."}]}],
"max_blocks":6,"presets":[{"name":"Benefits","blocks":[{"type":"benefit","settings":{"icon":"truck"}},{"type":"benefit","settings":{"icon":"shield"}},{"type":"benefit","settings":{"icon":"headset"}}]}]}
{% endschema %}