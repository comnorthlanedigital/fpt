{%- comment -%}
  Back-of-jersey preview. JS (theme.js, [data-jersey]) swaps the name, number and colours.
  Usage: {% render 'jersey-svg', uid: section.id, name: 'LEGEND', number: '10' %}
{%- endcomment -%}
<svg class="jersey" viewBox="0 0 400 460" role="img" aria-label="Jersey back preview" data-jersey>
  <defs>
    <linearGradient id="jf-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".18"/>
      <stop offset=".5" stop-color="#ffffff" stop-opacity="0"/>
      <stop offset="1" stop-color="#000000" stop-opacity=".3"/>
    </linearGradient>
    <pattern id="jm-{{ uid }}" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="1" height="6" fill="#000000" opacity=".08"/>
    </pattern>
  </defs>
  <ellipse cx="200" cy="440" rx="130" ry="12" fill="#000000" opacity=".5"/>
  <path data-j="body" d="M118 40 L56 72 L14 156 L68 184 L96 146 L96 408 Q200 430 304 408 L304 146 L332 184 L386 156 L344 72 L282 40 Q200 92 118 40Z" fill="#0c0c0b"/>
  <path data-j="stripe" d="M14 156 L68 184 L78 164 L30 138Z M386 156 L332 184 L322 164 L370 138Z" fill="#d6a93f"/>
  <path data-j="trim" d="M118 40 Q200 92 282 40 L272 36 Q200 78 128 36Z" fill="#d6a93f"/>
  <path data-j="stripe" d="M96 392 Q200 414 304 392 L304 408 Q200 430 96 408Z" fill="#d6a93f"/>
  <path d="M118 40 L56 72 L14 156 L68 184 L96 146 L96 408 Q200 430 304 408 L304 146 L332 184 L386 156 L344 72 L282 40 Q200 92 118 40Z" fill="url(#jm-{{ uid }})"/>
  <path d="M118 40 L56 72 L14 156 L68 184 L96 146 L96 408 Q200 430 304 408 L304 146 L332 184 L386 156 L344 72 L282 40 Q200 92 118 40Z" fill="url(#jf-{{ uid }})"/>
  <text data-j="name" x="200" y="136" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="44" letter-spacing="3" fill="#f0cf6a">{{ name | default: 'LEGEND' | upcase }}</text>
  <text data-j="number" x="200" y="298" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="170" fill="#f0cf6a">{{ number | default: '10' }}</text>
</svg>
