<section class="cta-banner">
  <div class="wrap cta-banner__in" data-reveal>
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- liquid
      assign cta_url = section.settings.button_link
      if cta_url == blank
        assign ambassador_page = pages['join-and-get-paid']
        if ambassador_page.title != blank
          assign cta_url = ambassador_page.url
        endif
      endif
    -%}
    {%- if section.settings.button_label != blank and cta_url != blank -%}
      <a class="btn btn--ink" href="{{ cta_url }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the crew" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "AMBASSADOR PROGRAM." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Share your link, earn on every order made through it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join and get paid" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the page with handle join-and-get-paid, if your store has one." }
  ],
  "presets": [ { "name": "Call to action" } ]
}
{% endschema %}
