<section class="page">
  <div class="wrap">
    <div class="account-head">
      <h1 class="display">{{ 'customer.account_title' | t }}</h1>
      <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
    </div>
    <p class="muted">{{ customer.name }} &middot; {{ customer.email }}</p>

    <h2 class="info__h">{{ 'customer.orders' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.payment' | t }}</th><th>{{ 'customer.fulfillment' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="muted">{{ 'customer.no_orders' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}

    <p><a class="btn btn--line" href="{{ routes.account_addresses_url }}">{{ 'customer.view_addresses' | t }}</a></p>
  </div>
</section>
