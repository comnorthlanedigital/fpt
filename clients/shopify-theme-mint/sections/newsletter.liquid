<section class="sec sec--alt">
  <div class="wrap wrap--narrow center">
    <h2 class="sec__title">{{ section.settings.heading }}</h2>
    <p class="muted">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'nl' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr" for="nl-email">Email</label>
      <input id="nl-email" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email" value="{{ form.email }}">
      <button class="btn" type="submit">Subscribe</button>
      {%- if form.posted_successfully? -%}<p class="ok" role="status">Thanks for subscribing.</p>{%- endif -%}
      {%- if form.errors -%}<p class="err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join the list"},{"type":"textarea","id":"text","label":"Text","default":"Tell people what they get by signing up."}],"presets":[{"name":"Newsletter"}]}
{% endschema %}