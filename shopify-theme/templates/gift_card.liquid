{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <section class="page">
      <div class="wrap wrap--narrow gift">
        <h1 class="display">{{ 'gift_card.title' | t }}</h1>
        <p class="gift__balance">{{ 'gift_card.balance' | t }}: <b>{{ gift_card.balance | money }}</b></p>
        <p class="gift__code mono" id="GiftCode">{{ gift_card.code | format_code }}</p>
        <p class="muted">{{ 'gift_card.use' | t }}</p>
        <a class="btn btn--gold" href="{{ shop.url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    </section>
  </body>
</html>
