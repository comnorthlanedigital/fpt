{%- liquid
  assign fc = section.settings.collection
  if fc == blank
    assign fc = collections.all
  endif
-%}
<section class="drops" id="drops-{{ section.id }}">
  <div class="drops__in">
    <div class="drops__side">
      <div class="drops__sticky" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="display">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
        <a class="btn btn--ink" href="{{ fc.url }}">{% if section.settings.button_label != blank %}{{ section.settings.button_label }}{% else %}{{ 'general.view_all' | t }}{% endif %}</a>
      </div>
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- for product in fc.products limit: section.settings.products_count -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="pcard pcard--empty"><div class="pcard__media">{{ 'product-1' | placeholder_svg_tag: 'pcard__img placeholder' }}</div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fresh off the press" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "NEW DROPS." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "26/27 kits, player issue and more." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "All collections" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "3" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
