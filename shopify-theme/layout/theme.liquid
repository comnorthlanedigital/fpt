<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=Permanent+Marker&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.search' | t }}: {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page_x_of_y' | t: current: current_page, total: 'many' }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {% style %}
      :root {
        --c-bg: {{ settings.color_bg }};
        --c-panel: {{ settings.color_panel }};
        --c-green: {{ settings.color_green }};
        --c-green-dark: {{ settings.color_green_dark }};
        --c-gold: {{ settings.color_gold }};
        --c-gold-deep: {{ settings.color_gold_deep }};
        --c-text: {{ settings.color_text }};
        --c-muted: {{ settings.color_muted }};
        --logo-h: {{ settings.logo_width }}px;
      }
    {% endstyle %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        smoothScroll: {{ settings.smooth_scroll | json }},
        animations: {{ settings.animations | json }},
        personalizationTag: {{ settings.personalization_tag | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          cartJson: {{ routes.cart_url | append: '.js' | json }}
        },
        strings: {
          emptyCart: {{ 'cart.empty' | t | json }},
          remove: {{ 'cart.remove' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          unavailable: {{ 'product.unavailable' | t | json }},
          errorMax: {{ 'cart.error_max' | t | json }},
          quantity: {{ 'cart.quantity' | t | json }}
        }
      };
    </script>

    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    {%- if settings.smooth_scroll -%}
      <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handleize }}{% if request.design_mode %} design-mode{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_type == 'drawer' %}
      {% render 'cart-drawer' %}
    {% endif %}
  </body>
</html>
