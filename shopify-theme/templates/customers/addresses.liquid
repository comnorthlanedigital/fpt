<section class="page">
  <div class="wrap">
    <a class="link" href="{{ routes.account_url }}">&larr; {{ 'customer.account_title' | t }}</a>
    <h1 class="display">{{ 'customer.addresses' | t }}</h1>

    {%- paginate customer.addresses by 10 -%}
      {%- if customer.addresses.size == 0 -%}<p class="muted">{{ 'customer.no_addresses' | t }}</p>{%- endif -%}
      <div class="grid grid--3">
        {%- for address in customer.addresses -%}
          <article class="address">
            {{ address | format_address }}
            <details>
              <summary class="link">{{ 'customer.edit' | t }}</summary>
              {%- form 'customer_address', address -%}
                {% render 'address-fields', address: address, form: form %}
                <button type="submit" class="btn btn--gold btn--sm">{{ 'customer.save' | t }}</button>
              {%- endform -%}
            </details>
            {%- form 'customer_address', address, class: 'address__delete', method: 'delete' -%}
              <button type="submit" class="link link--small">{{ 'customer.delete' | t }}</button>
            {%- endform -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endpaginate -%}

    <h2 class="info__h">{{ 'customer.add_address' | t }}</h2>
    {%- form 'customer_address', customer.new_address -%}
      {{ form.errors | default_errors }}
      {% render 'address-fields', address: customer.new_address, form: form %}
      <button type="submit" class="btn btn--gold">{{ 'customer.save' | t }}</button>
    {%- endform -%}
  </div>
</section>
