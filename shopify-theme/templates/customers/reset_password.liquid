<section class="page">
  <div class="wrap wrap--narrow">
    <h1 class="display">{{ 'customer.reset_title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="field"><span>{{ 'customer.confirm_password' | t }}</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--gold">{{ 'customer.reset_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
