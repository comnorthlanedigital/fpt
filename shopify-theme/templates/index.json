    "faq": {
      "type": "faq",
      "blocks": {
        "q0": {
          "type": "question",
          "settings": {
            "question": "How do I add a name and number?",
            "answer": "<p>Open any jersey and use the <strong>Make it yours</strong> box. Type the name and number, watch the preview update, and add to cart. They are saved with your order. Forgot? Email <a href=\"mailto:customercare@fptsportz.com\">customercare@fptsportz.com</a>.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship in 6–10 working days and are guaranteed within 11–15 working days. Once your order is placed it is processed and shipped, and a tracking number is emailed to you.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>You get a tracking number by email once it ships. Order updates are also posted on our Instagram story, @fptsportz.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Which size should I get?",
            "answer": "<p><strong>Player Issue:</strong> skin-slim, so take your normal size or one up. <strong>Standard:</strong> fitted with a little room, so go up a size if you like it loose. <strong>Women:</strong> V-shaped slim fit, size up for a looser feel.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I become an ambassador?",
            "answer": "<p>Yes. Sign up, get your shareable link, and earn on purchases made through it. Standout ambassadors can be invited to become official FPT Sportz ambassadors.</p>"
          }
        }
      },
