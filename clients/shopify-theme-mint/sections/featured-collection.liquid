<section class="sec">
  <div class="wrap">
    <h2 class="sec__title">{{ section.settings.heading }}</h2>
    {%- assign col = section.settings.collection -%}
    <div class="grid">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: section.settings.count -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}<article class="pcard"><div class="pcard__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div><div class="pcard__body"><h3 class="pcard__title">Example product</h3><span class="price">$0.00</span></div></article>{%- endfor -%}
      {%- endif -%}
    </div>
    {% if section.settings.show_all %}<p class="center"><a class="btn btn--ghost" href="{{ col.url | default: routes.all_products_collection_url }}">View all</a></p>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"count","label":"Products","min":2,"max":12,"step":2,"default":4},
{"type":"checkbox","id":"show_all","label":"Show View all button","default":true}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}