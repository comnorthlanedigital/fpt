<section class="sec sec--alt">
  <div class="wrap">
    <h2 class="sec__title">{{ section.settings.heading }}</h2>
    <div class="rev">
      {%- for block in section.blocks -%}
      <blockquote class="rev__i" {{ block.shopify_attributes }}>
        <p class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}&#9733;{% endfor %}</p>
        <p>{{ block.settings.text }}</p>
        <footer><b>{{ block.settings.name }}</b>{% if block.settings.role != blank %}<span class="muted"> &middot; {{ block.settings.role }}</span>{% endif %}</footer>
      </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"What customers say"}],
"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Stars","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"text","label":"Review","info":"Use real, permitted customer reviews only."},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"role","label":"Detail"}]}],
"max_blocks":6,"presets":[{"name":"Reviews"}]}
{% endschema %}