<section class="sec">
  <div class="wrap wrap--narrow">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2 class="sec__title left">{{ section.settings.heading }}</h2>
    {%- for block in section.blocks -%}
    <details class="faq" {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="faq__a">{{ block.settings.a }}</div></details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Before you buy"},{"type":"text","id":"heading","label":"Heading","default":"Questions, answered."}],
"blocks":[{"type":"item","name":"Question","settings":[{"type":"text","id":"q","label":"Question","default":"Your question?"},{"type":"richtext","id":"a","label":"Answer","default":"<p>Your answer.</p>"}]}],
"max_blocks":14,"presets":[{"name":"FAQ","blocks":[{"type":"item"},{"type":"item"}]}]}
{% endschema %}