<section class="sec sec--alt">
  <div class="wrap">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="sec__title left">{{ section.settings.heading }}</h2>
    <div class="igrid">
      {%- for block in section.blocks -%}
      <figure class="igrid__i" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 900px) 25vw, 50vw', alt: block.settings.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'placeholder' }}{% endif %}
        {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}
      </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Image gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"In the wild"},{"type":"text","id":"heading","label":"Heading","default":"Real customers, real photos."}],
"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption"}]}],
"max_blocks":8,"presets":[{"name":"Image gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}