<section class="crew" data-crew data-autoplay="{{ section.settings.autoplay }}" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
  <div class="crew__slides">
    {%- for block in section.blocks -%}
      {%- assign n = forloop.index0 | modulo: 4 | plus: 1 -%}
      <figure class="crew__slide{% if forloop.first %} is-active{% endif %}{% if block.settings.fit == 'contain' %} crew__slide--contain{% endif %}" data-crew-slide {{ block.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '100vw', loading: 'lazy', alt: block.settings.handle, class: 'crew__img' }}
        {%- else -%}
          <img class="crew__img" src="{% render 'crew-photo', n: n %}" alt="{{ block.settings.handle | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1100" height="1100">
        {%- endif -%}
        <figcaption class="crew__cap">
          <span class="crew__handle">{{ block.settings.handle }}</span>
          {%- if block.settings.caption != blank -%}<span class="crew__text">{{ block.settings.caption }}</span>{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a class="crew__link" href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Shop the look' }} {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
  <div class="crew__top">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="crew__title">{{ section.settings.heading }}</h2>
  </div>
  <div class="crew__ui">
    <ol class="crew__dots" role="tablist" aria-label="Slides">
      {%- for block in section.blocks -%}
        <li><button type="button" role="tab" data-crew-dot aria-label="{{ block.settings.handle | escape }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"><i></i></button></li>
      {%- endfor -%}
    </ol>
    <div class="crew__nav">
      <span class="crew__count" aria-hidden="true"><b data-crew-now>01</b> / {{ section.blocks.size | prepend: '00' | slice: -2, 2 }}</span>
      <button type="button" class="icon-btn" data-crew-prev aria-label="Previous">{% render 'icon', name: 'arrow' %}</button>
      <button type="button" class="icon-btn" data-crew-next aria-label="Next">{% render 'icon', name: 'arrow' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Crew slideshow",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The crew" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "WORN BY THE STANDS." },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-advance", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait or square works best. Leave empty to use the sample photo." },
        { "type": "text", "id": "handle", "label": "Instagram handle", "default": "@handle" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link (product or collection)" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the look" },
        { "type": "select", "id": "fit", "label": "Photo fit", "options": [ { "value": "cover", "label": "Fill the screen (crop)" }, { "value": "contain", "label": "Show the whole photo" } ], "default": "cover" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [ { "name": "Crew slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}
