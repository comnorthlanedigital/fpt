<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    {% style %}
      :root { --c-bg: {{ settings.color_bg }}; --c-gold: {{ settings.color_gold }}; --c-text: {{ settings.color_text }}; --c-muted: {{ settings.color_muted }}; --c-green-dark: {{ settings.color_green_dark }}; --c-panel: {{ settings.color_panel }}; --c-green: {{ settings.color_green }}; --c-gold-deep: {{ settings.color_gold_deep }}; --logo-h: {{ settings.logo_width }}px; }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main class="main" id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
