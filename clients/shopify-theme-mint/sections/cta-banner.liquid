<section class="sec cta">
  <div class="wrap center">
    <h2 class="sec__title">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p class="muted">{{ section.settings.text }}</p>{% endif %}
    <div class="hero__cta c">
      {% if section.settings.btn1_label != blank %}<a class="btn" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{% endif %}
      {% if section.settings.btn2_label != blank %}<a class="btn btn--ghost" href="{{ section.settings.btn2_link | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Call to action","settings":[{"type":"text","id":"heading","label":"Heading","default":"Ready when you are."},{"type":"textarea","id":"text","label":"Text"},
{"type":"text","id":"btn1_label","label":"Primary button","default":"Shop now"},{"type":"url","id":"btn1_link","label":"Primary link"},{"type":"text","id":"btn2_label","label":"Secondary button"},{"type":"url","id":"btn2_link","label":"Secondary link"}],"presets":[{"name":"Call to action"}]}
{% endschema %}